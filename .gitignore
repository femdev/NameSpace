# macOS
.DS_Store

# Xcode — user-specific state (never share)
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# Xcode — build products & derived data
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager (not used here, but harmless to ignore)
.build/
.swiftpm/

# Signing / local secrets
*.p12
*.p8
*.mobileprovision
# Machine-local signing override written by setup-signing.sh (never commit)
Signing.local.xcconfig

# Release packaging output (scripts/package-release.sh)
dist/

# Editor cruft
*.swp
*~
